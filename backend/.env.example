# Ambiente
NODE_ENV=development
PORT=3001

# Banco de Dados PostgreSQL
# Para desenvolvimento local, use: postgresql://user:password@localhost:5432/adaptador_db
DATABASE_URL="postgresql://user:password@localhost:5432/adaptador_db"

# JWT Secret (gere um valor seguro para produção)
JWT_SECRET="seu-jwt-secret-super-seguro-aqui"
JWT_EXPIRES_IN="7d"

# Stripe (obtenha em https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
